{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "kerboscript",
      "camelcase": "Kerboscript",
      "title": "Kerboscript",
      "scope": "source.kerboscript",
      "file-types": [
        "ks"
      ],
      "injection-regex": "^kerboscript$",
      "class-name": "TreeSitterKerboscript"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPLv3",
    "description": "Kerboscript grammar for tree-sitter",
    "authors": [
      {
        "name": "Doctor-Cpu",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/Doctor-Cpu/tree-sitter-kerboscript",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}